# Local development template. Copy to .env; never commit real values.
GANDIWA_ENV=development
GANDIWA_API_HOST=127.0.0.1
GANDIWA_API_PORT=8000
GANDIWA_PUBLIC_ORIGIN=http://localhost:5173
GANDIWA_ALLOWED_ORIGINS=http://localhost:5173
GANDIWA_TRUSTED_HOSTS=localhost,127.0.0.1
GANDIWA_SESSION_SECRET=CHANGE_ME_FOR_LOCAL_DEVELOPMENT
GANDIWA_SECURE_COOKIES=false

GANDIWA_DATABASE_URL=sqlite:///./var/gandiwa.sqlite3
GANDIWA_ARTIFACT_DIR=./var/artifacts
GANDIWA_SQLITE_BUSY_TIMEOUT_MS=5000
GANDIWA_WORKER_CONCURRENCY=1
GANDIWA_QUEUE_POLL_INTERVAL_SECONDS=2
GANDIWA_JOB_LEASE_SECONDS=120
GANDIWA_JOB_HEARTBEAT_SECONDS=30
GANDIWA_MAX_JOB_ATTEMPTS=3
GANDIWA_ARTIFACT_RETENTION_HOURS=24
GANDIWA_MAX_UPLOAD_BYTES=52428800
GANDIWA_MAX_ARTIFACT_BYTES=104857600
GANDIWA_LOG_LEVEL=DEBUG

# Optional MVP connectors. Values stay server-side.
NINEROUTER_BASE_URL=http://TAILSCALE_IP:20128/v1
NINEROUTER_API_KEY=
FAL_KEY=
