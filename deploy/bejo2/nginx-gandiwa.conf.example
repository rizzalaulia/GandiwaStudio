# Install as a NEW dedicated vhost only after replacing GANDIWA_HOSTNAME and
# provisioning its certificate. Do not edit any existing site file.
server {
    listen 80;
    listen [::]:80;
    server_name GANDIWA_HOSTNAME;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name GANDIWA_HOSTNAME;

    ssl_certificate /etc/letsencrypt/live/GANDIWA_HOSTNAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/GANDIWA_HOSTNAME/privkey.pem;

    root /var/www/gandiwa/current;
    index index.html;
    client_max_body_size 50m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:" always;

    location /api/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 310s;
        proxy_read_timeout 310s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.svg$ {
        return 404;
    }
}
