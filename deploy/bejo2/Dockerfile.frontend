FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9

ENV COREPACK_HOME=/opt/corepack \
    HOME=/home/node

RUN mkdir -p /opt/corepack /home/node \
    && corepack enable \
    && corepack install --global pnpm@12.3.4 \
    && pnpm --version \
    && chmod -R a+rX /opt/corepack /home/node

USER 10001:10001
WORKDIR /work
