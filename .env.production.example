# Production template only. Copy outside the repository to:
# /etc/gandiwa/gandiwa.env
# Never commit real values.

GANDIWA_ENV=production
GANDIWA_API_HOST=0.0.0.0
GANDIWA_API_PORT=8000
GANDIWA_PUBLIC_ORIGIN=https://gandiwa.example.com
GANDIWA_ALLOWED_ORIGINS=https://gandiwa.example.com
GANDIWA_TRUSTED_HOSTS=gandiwa.example.com

# Generate a unique high-entropy value during deployment.
GANDIWA_SESSION_SECRET=CHANGE_ME
GANDIWA_SECURE_COOKIES=true

GANDIWA_DATABASE_URL=sqlite:////var/lib/gandiwa/gandiwa.sqlite3
GANDIWA_ARTIFACT_DIR=/var/cache/gandiwa/artifacts
GANDIWA_SQLITE_BUSY_TIMEOUT_MS=5000

GANDIWA_WORKER_CONCURRENCY=1
GANDIWA_QUEUE_POLL_INTERVAL_SECONDS=2
GANDIWA_JOB_LEASE_SECONDS=120
GANDIWA_JOB_HEARTBEAT_SECONDS=30
GANDIWA_MAX_JOB_ATTEMPTS=3
GANDIWA_ARTIFACT_RETENTION_HOURS=24

GANDIWA_MAX_UPLOAD_BYTES=52428800
GANDIWA_MAX_ARTIFACT_BYTES=104857600
GANDIWA_LOG_LEVEL=INFO

# User-selected connectors; leave disabled/unset until configured.
NINEROUTER_BASE_URL=http://TAILSCALE_IP:20128/v1
NINEROUTER_API_KEY=
FAL_KEY=
